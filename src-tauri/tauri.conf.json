{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Notepad OS",
  "version": "0.1.1",
  "identifier": "com.notepados.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notepad OS",
        "width": 1024,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNDkxRDVGREY0MUIyOTkKUldTWnNrSGZYeDFKS2tKSHV4ODh1VUZ6aFJIUWVZc3liNVcwSUlOYUlaM01HQTYyTC9FWTJZY1QK",
      "endpoints": [
        "https://github.com/sajidhossain8272/notepad-os/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
